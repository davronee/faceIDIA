# ==============================================================================
# FaceID Enterprise Production Environment Template (.env.production.example)
# Barcha maxfiy kalitlar va parollar placeholder (shablon) sifatida berilgan.
# Haqiqiy serverda xavfsiz generatsiya qilish uchun: ./setup-env.sh
# ==============================================================================

# 1. Laravel Ilova Sozlamalari
APP_NAME="FaceID Enterprise Biometrics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en

# 2. Ichki PostgreSQL Ma'lumotlar Bazasi (pgvector)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=face_recognition
DB_USERNAME=faceidia_user
DB_PASSWORD=

# 3. Redis Kesh va Asinxron Navbatlar
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# 4. Log Jurnallari
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# 5. Mobil Ilova va Tashqi B2B Mijozlar Kalitlari
MOBILE_APP_KEY=
EXTERNAL_API_KEY=

# 6. Davlat eGov Pasport GCP Shlyuzi (gateway.imv.uz)
EGOV_PASSPORT_BASE_URL="https://gateway.imv.uz/api/v1"
EGOV_AUTH_ENDPOINT="/auth/token"
EGOV_PASSPORT_ENDPOINT="/egov/passport-gcp-document-birthdate"
EGOV_AUTH_USERNAME=""
EGOV_AUTH_PASSWORD=""
EGOV_PASSPORT_TOKEN=""

# 7. Ichki AI Mikroxizmati (FastAPI ArcFace 512-d)
AI_SERVICE_URL=http://backend:8000
INTERNAL_AI_SECRET=

# 8. Bosh Administrator Hisobi (MoonShine Admin Panel)
ADMIN_DEFAULT_EMAIL=admin@yourdomain.uz
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME="Bosh Administrator"

# 9. Octane Web Server (FrankenPHP)
OCTANE_SERVER=frankenphp
